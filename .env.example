DATABASE_URL=sqlite:///./reality.db
# LLM provider: "groq" (default, enter key in UI) | "hosted" (env-var key) | "chatgpt" (OAuth)
LLM_PROVIDER=groq
# Optional: pre-set Groq key and model via env instead of UI entry
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
# Only used when LLM_PROVIDER=hosted with a custom OpenAI-compatible endpoint
LLM_BASE_URL=https://api.groq.com/openai/v1
API_URL=http://127.0.0.1:8000
POSTGRES_PASSWORD=
DOMAIN=localhost
